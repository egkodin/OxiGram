// @generated by tools/style-gen from fixture.
// Derived from Telegram Desktop (GPLv3); see NOTICE.md. Do not edit.

use crate::Color;

/// Telegram Desktop's color palette (`colors.palette`).
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Palette {
    /// white: fallback for background
    pub window_bg: Color,
    /// reference to an earlier color
    ///
    /// Same as `windowBg` by default.
    pub window_fg_over: Color,
    /// with opacity
    pub shadow_fg: Color,
    /// value with a theme fallback
    pub history_peer1_userpic_bg2: Color,
}

impl Palette {
    /// The default (day) palette.
    pub const DEFAULT: Self = Self {
        window_bg: Color::rgba(0xff, 0xff, 0xff, 0xff),
        window_fg_over: Color::rgba(0xff, 0xff, 0xff, 0xff),
        shadow_fg: Color::rgba(0x00, 0x00, 0x00, 0x18),
        history_peer1_userpic_bg2: Color::rgba(0xd4, 0x52, 0x46, 0xff),
    };

    /// The color `id` names.
    #[must_use]
    pub const fn get(&self, id: ColorId) -> Color {
        match id {
            ColorId::WindowBg => self.window_bg,
            ColorId::WindowFgOver => self.window_fg_over,
            ColorId::ShadowFg => self.shadow_fg,
            ColorId::HistoryPeer1UserpicBg2 => self.history_peer1_userpic_bg2,
        }
    }
}

/// Names a palette color; style values refer to colors by it, so themes apply.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum ColorId {
    WindowBg,
    WindowFgOver,
    ShadowFg,
    HistoryPeer1UserpicBg2,
}
